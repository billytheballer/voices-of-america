# ---- Client (exposed to the browser: never put secrets here) ----
# "mock" runs the whole game offline with deterministic fixtures. "proxy" calls /api/*.
VITE_LLM_MODE=mock

# ---- Server only (serverless proxy in /api) ----
ANTHROPIC_API_KEY=
# Sonnet is the cost/quality sweet spot for bill parsing + feed generation.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Comma-separated origins allowed to call /api in production, e.g. https://voices.example.com
ALLOWED_ORIGINS=
